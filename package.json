{
	"name": "pi-claude-billing-router",
	"version": "0.1.1",
	"description": "Route Claude Pro/Max OAuth requests in pi between your plan and extra-usage credits: plan first, automatic fallback to credits when the 5h window is exhausted, /billing override, live usage in the footer.",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"pi-coding-agent",
		"anthropic",
		"claude",
		"claude-max",
		"claude-pro",
		"subscription",
		"extra-usage",
		"billing",
		"oauth",
		"usage"
	],
	"type": "module",
	"license": "MIT",
	"author": "Francisco José Delicado González (https://github.com/franndeli)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/franndeli/pi-claude-billing-router.git"
	},
	"homepage": "https://github.com/franndeli/pi-claude-billing-router#readme",
	"bugs": "https://github.com/franndeli/pi-claude-billing-router/issues",
	"files": [
		"extensions/",
		"lib/",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"scripts": {
		"pretest": "node test/link-pi.mjs",
		"test": "node --test test/*.test.ts",
		"typecheck": "node test/link-pi.mjs && tsc -p ."
	}
}
